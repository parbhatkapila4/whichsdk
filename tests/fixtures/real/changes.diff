@@ -0,0 +1,21 @@
+import "server-only";
+import { randomBytes, scrypt, timingSafeEqual } from "node:crypto";
+
+function derive(password: string, salt: Buffer): Promise<Buffer> {
+  return new Promise((resolve, reject) =>
+    scrypt(password, salt, 64, (err, key) => (err ? reject(err) : resolve(key))),
+  );
+}
+
+export async function hashPassword(password: string): Promise<string> {
+  const salt = randomBytes(16);
+  const key = await derive(password, salt);
+  return `${salt.toString("hex")}:${key.toString("hex")}`;
+}
+
+export async function verifyPassword(password: string, stored: string): Promise<boolean> {
+  const [saltHex, keyHex] = stored.split(":");
+  const expected = Buffer.from(keyHex, "hex");
+  const actual = await derive(password, Buffer.from(saltHex, "hex"));
+  return expected.length === actual.length && timingSafeEqual(expected, actual);
+}
diff --git a/lib/session.ts b/lib/session.ts
new file mode 100644
index 0000000..9fefe93
--- /dev/null
+++ b/lib/session.ts
@@ -0,0 +1,59 @@
+import "server-only";
+import { createHash, randomBytes } from "node:crypto";
+import { cache } from "react";
+import { cookies } from "next/headers";
+import { redirect } from "next/navigation";
+import { read, transaction } from "./db";
+
+const COOKIE = "session";
+const MAX_AGE_MS = 7 * 24 * 60 * 60 * 1000;
+
+// Only a hash of the token is stored, so a leaked data file can't be used to hijack sessions.
+const hash = (token: string) => createHash("sha256").update(token).digest("hex");
+
+export async function createSession(userId: string) {
+  const token = randomBytes(32).toString("base64url");
+  const expiresAt = Date.now() + MAX_AGE_MS;
+  await transaction((data) => {
+    const now = Date.now();
+    data.sessions = data.sessions.filter((s) => s.expiresAt > now);
+    data.sessions.push({ tokenHash: hash(token), userId, expiresAt });
+  });
+  (await cookies()).set(COOKIE, token, {
+    httpOnly: true,
+    secure: process.env.NODE_ENV === "production",
+    sameSite: "lax",
+    path: "/",
+    expires: expiresAt,
+  });
+}
+
+export async function destroySession() {
+  const jar = await cookies();
+  const token = jar.get(COOKIE)?.value;
+  if (token) {
+    await transaction((data) => {
+      data.sessions = data.sessions.filter((s) => s.tokenHash !== hash(token));
+    });
+  }
+  jar.delete(COOKIE);
+}
+
+// Returns the logged-in user or null. Memoized per request.
+export const getUser = cache(async () => {
+  const token = (await cookies()).get(COOKIE)?.value;
+  if (!token) return null;
+  const tokenHash = hash(token);
+  return read((data) => {
+    const session = data.sessions.find((s) => s.tokenHash === tokenHash);
+    if (!session || session.expiresAt <= Date.now()) return null;
+    const user = data.users.find((u) => u.id === session.userId);
+    return user ? { id: user.id, email: user.email } : null;
+  });
+});
+
+export async function requireUser() {
+  const user = await getUser();
+  if (!user) redirect("/login");
+  return user;
+}
